# ── Automatist Release Signing ────────────────────────────────────────
# Copy this file to keystore.properties (which is .gitignored) and fill
# in your actual values.
#
# To generate a release keystore:
#   keytool -genkeypair -v -keystore automatist-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias automatist -storepass YOUR_STORE_PASSWORD -keypass YOUR_KEY_PASSWORD
#
# Then fill in the fields below:

storeFile=automatist-release.jks
storePassword=
keyAlias=automatist
keyPassword=
