# Built application files
*.apk
*.aab
*.ap_
*.aar

# Files for the ART/Dalvik VM
*.dex

# Java/Kotlin class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (SDK path, etc)
local.properties

# Proguard
proguard/

# Log files
*.log

# Android Studio / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Keystore files (IMPORTANT - never commit)
*.jks
*.keystore
keystore.properties

# Navigation component
.navigation/

# Kotlin
*.kotlin_module

# Google Services (Firebase)
google-services.json

# Android profiling
*.hprof

# OS files
.DS_Store
Thumbs.db

# Captures (screenshots, recordings)
captures/

# NDK
.externalNativeBuild/
.cxx/

# Build cache
buildCache/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Misc
*.swp
*~
app context.txt

# On-device model weights & caches (downloaded at runtime; never commit)
models/
*.task
*.litertlm
*.gguf
*.safetensors
*.onnx

# Secrets / credentials (never commit)
# NOTE: keep patterns specific so legitimate JSON docs/examples and the
# gradle wrapper stay tracked. Do NOT add a blanket "*.json" rule.
*service-account*.json
*service_account*.json
client_secret*.json
*-oauth-client*.json
*.p12
*.pem
*.der